# Python
__pycache__/
*.py[cod]
*.so
.Python
*.egg-info/
*.egg
build/
dist/

# Virtual environments
venv/
env/
.venv/

# Jupyter
.ipynb_checkpoints/

# VS Code
.vscode/*
!.vscode/settings.json

# Evaluation items are tracked; anything else dropped in data/ is not
data/*
!data/.gitkeep
!data/*.jsonl

# Results are tracked, with two exceptions distributed via Zenodo instead:
#   - activation tensors (large, regenerable from the weights and prompts)
#   - raw per-judge judgment files (large; aggregates and rates are tracked)
results/**/*.pt
results/**/activations/
results/**/judge_*.jsonl

# Model artifacts
*.ckpt
*.bin
*.safetensors

# HuggingFace cache (can be huge)
.cache/

# Reference materials
_reference/

# OS
.DS_Store
Thumbs.db
*:Zone.Identifier

# pytest / linters
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Local environment
.env
*.local
review/

# Backup files
*.bak
*.prepurge.bak

# Private working notes and draft chapters
notes/
judge_validation_observations.md
workspace/
lbe_v1_data.zip

# Superseded by the Zenodo deposit
results/judgments/*.zip

# Console logs; the JSON and CSV outputs beside them carry the results
logs/
results/**/*.log

# Derived from tracked runs by tracked scripts
results/interp/fold2/
results/interp/ablation_smoke.jsonl

# Superseded by the Zenodo deposit
results/judgments/*.zip

